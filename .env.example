# Local ports. Change these if another application uses them.
ZHIGUANG_WEB_PORT=15173
ZHIGUANG_API_PORT=18082
# Search indexes titles/descriptions locally. Enable fetching only for reachable content URLs.
SEARCH_FETCH_CONTENT=false
# Optional paid/external services. Leave blank to start the community locally.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_PUBLIC_DOMAIN=
