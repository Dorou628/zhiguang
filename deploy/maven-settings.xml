<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
    <!-- All project dependencies are releases. Avoid obsolete repositories
         inherited from dependency POMs during a clean container build. -->
    <mirrors>
        <mirror>
            <id>central-only</id>
            <mirrorOf>*</mirrorOf>
            <url>https://repo.maven.apache.org/maven2</url>
        </mirror>
    </mirrors>
</settings>
